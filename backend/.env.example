APP_NAME="MUE 3+1"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mue.kurum.example
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR
APP_TIMEZONE=UTC
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mue
DB_USERNAME=mue_app
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
FILESYSTEM_DISK=local
MATCHING_PYTHON=/opt/venv/bin/python
MATCHING_RUNNER=/app/optimizer/runner.py
# Gerçek çalıştırılabilir ClamAV tarayıcı yolu
DOCUMENT_SCANNER=
BACKUP_ENABLED=false
BACKUP_PG_DUMP=pg_dump
# Web kökü dışında, kısıtlı izinli kalıcı dizin; boş bırakılırsa storage/app/backups
BACKUP_DIRECTORY=
BACKUP_TIMEOUT_SECONDS=600
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=mue@kurum.example
MAIL_FROM_NAME="MUE 3+1"
